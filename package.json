{
  "name": "voicetotextfree",
  "version": "1.0.0",
  "private": true,
  "description": "VoiceToTextFree - free, private, browser-based subtitle and transcript generator powered by Whisper.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run check:content && npm run verify:keywords && npm run verify:wordcount && npm run verify:aeo && npm run verify:tokens && next build --webpack && node scripts/flatten-rsc.mjs && npm run verify:output",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:content": "tsx scripts/check-content.ts",
    "verify:keywords": "tsx scripts/verify-keywords.ts",
    "verify:wordcount": "tsx scripts/verify-wordcount.ts",
    "verify:aeo": "tsx scripts/verify-aeo.ts",
    "verify:tokens": "tsx scripts/verify-tokens.ts",
    "verify:emails": "tsx scripts/verify-emails.ts",
    "verify:log": "tsx scripts/verify-log.ts",
    "verify:features": "tsx scripts/verify-features.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "verify:ads": "tsx scripts/verify-ads.ts",
    "verify:output": "tsx scripts/verify-output.ts",
    "check:all": "npm run check:content && npm run verify:keywords && npm run verify:wordcount && npm run verify:aeo && npm run verify:tokens && npm run verify:emails && npm run verify:log && npm run verify:features && npm run verify:links && npm run verify:ads && npm run format:check && npm run typecheck && npm run lint && npm test",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "llms": "tsx scripts/generate-llms.ts"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "4.3.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@ffmpeg/core": "0.12.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.0.5"
  }
}
