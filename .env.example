# VoiceToTextFree environment variables
# This site is fully static. These values are build-time only.

# Leave ADS_ENABLED=false until AdSense approves the site.
NEXT_PUBLIC_ADS_ENABLED=false

# AdSense publisher ID, for example ca-pub-0000000000000000.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# AdSense ad unit IDs. Every enabled placement needs its own ID.
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=

# Public site URL used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://voicetotextfree.top

# Contact email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=ihsanaslamm@gmail.com

# Real creator and maintainer details for authorship signals.
NEXT_PUBLIC_AUTHOR_NAME=Abdul Samad
NEXT_PUBLIC_AUTHOR_BIO=Abdul Samad is the creator and maintainer of VoiceToTextFree and is responsible for the site's browser-based tool, subtitle guides and corrections.

# Search Console / Bing verification values. Empty means no meta tag is emitted.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow key supplied by Bing Webmaster Tools. Empty disables pinging.
INDEXNOW_KEY=
